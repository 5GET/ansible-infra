---
global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
          - '192.168.0.140:9093'

rule_files:
  - "alerts.yml"

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node-exporter'
    static_configs:
      - targets:
{% for host in groups['webservers'] %}
        - '{{ hostvars[host]["ansible_host"] }}:{{ node_exporter_port }}'
{% endfor %}

  - job_name: 'cadvisor'
    static_configs:
      - targets:
{% for host in groups['webservers'] %}
        - '{{ hostvars[host]["ansible_host"] }}:{{ cadvisor_port }}'
{% endfor %}
